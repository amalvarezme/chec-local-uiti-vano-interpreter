#!/bin/sh
# Lanzador de doble clic de macOS. Existe -- en vez de bastar con el `iniciar.command`
# de al lado -- por una razon medida en esta maquina:
#
#   open iniciar.command             -> Terminal.app abre una ventana y lo EJECUTA.
#   open -a Ghostty iniciar.command  -> no ejecuta nada. Ghostty se declara manejador de
#                                       `.command` en su Info.plist con
#                                       CFBundleTypeRole = Editor -- editor, no shell --
#                                       y lo unico que hace es llevarse el foco a la
#                                       sesion que ya estuviera abierta.
#
# Cual de las dos ocurre no lo decide el repositorio: lo decide la atadura de
# LaunchServices de cada maquina, que ademas se cambia sin querer desde el "Abrir con"
# del Finder. Y cuando toca la mala no hay arreglo posible DENTRO del script, porque el
# script no llega a correr. Un `.app` no se puede desviar asi: LaunchServices no lo abre
# con otra aplicacion, lo LANZA.
#
# Aqui no se arranca ninguna aplicacion. Se escribe un perfil de ventana de Terminal --
# un `.terminal`, que es un plist -- y se le da a Terminal.app.
#
# Nada de `osascript`, tambien por algo medido: pedirle a Terminal por AppleScript que
# abra o cierre una ventana exige el permiso de Automatizacion, y sin el la llamada no
# falla, se QUEDA COLGADA esperando un dialogo (19 s y subiendo, con la ventana muerta
# en pantalla). Es la misma trampa que la restriccion R1 del contrato de `/app-local-*`.
# Abrir un documento con `open` no pasa por Apple Events y no pide ningun permiso.
#
# El perfil lleva `RunCommandAsShell` y `shellExitAction = 0`, y hacen falta los DOS para
# que la ventana se cierre sola cuando el tablero se cierra -- que es la otra mitad de lo
# que este lanzador promete. Medido, uno por uno:
#
#   RunCommandAsShell falso  Terminal corre el comando DENTRO de un shell de login: el
#                            comando acaba, el shell sigue vivo, la ventana se queda.
#   RunCommandAsShell cierto el comando ES la sesion, y al acabar la ventana se cierra.
#
# Y con el cierto, `CommandString` NO lo interpreta ningun shell: se ejecuta tal cual.
# Medido: con `exec` delante no arranca, entre comillas tampoco, y una ruta con espacios
# no arranca. De ahi el trampolin de abajo -- un guion de dos lineas en una carpeta sin
# espacios -- que es lo unico que se le pasa a Terminal.

AQUI="$(cd "$(dirname "$0")" && pwd)"
APP="$(cd "$AQUI/../../.." && pwd)"
VENTANA="$(cd "$AQUI/.." && pwd)/Resources/ventana"
CLAVE="$(basename "$APP")"

# Una carpeta temporal SIN espacios, que es la condicion que impone `CommandString`.
# En macOS `TMPDIR` es `/var/folders/...` y no los lleva, pero comprobarlo cuesta una
# linea y el fallo que evita -- una ventana que no abre y no dice por que -- cuesta una
# tarde.
TEMP="${TMPDIR:-/tmp}"
case "$TEMP" in *" "*) TEMP=/tmp ;; esac

DESTINO="$TEMP/chec-$CLAVE-destino"
TRAMPOLIN="$TEMP/chec-$CLAVE-ventana.sh"
PERFIL="$TEMP/chec-$CLAVE-ventana.terminal"

# La ruta real va en un archivo aparte, no dentro del trampolin. Asi no hay que citarla
# ni escaparla: una carpeta con espacios, comillas o `&` en el nombre -- la elige quien
# clona el repositorio, no nosotros -- pasa entera sin tocar nada.
printf '%s' "$VENTANA" > "$DESTINO"
cat > "$TRAMPOLIN" <<FIN
#!/bin/sh
# Generado por Iniciar.app en cada arranque. No se edita: se reescribe.
exec "\$(cat "$DESTINO")"
FIN
chmod +x "$TRAMPOLIN"

cat > "$PERFIL" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>CriticidadCHEC</string>
	<key>type</key>
	<string>Window Settings</string>
	<key>CommandString</key>
	<string>$TRAMPOLIN</string>
	<key>RunCommandAsShell</key>
	<true/>
	<key>shellExitAction</key>
	<integer>0</integer>
</dict>
</plist>
PLIST

# `-a Terminal` y no el manejador por defecto: es justamente lo que hace que esto no se
# lo pueda quedar otro terminal, que es todo el motivo de que este bundle exista. Con
# Ghostty corriendo y en primer plano, esto abre igual una ventana NUEVA de Terminal --
# medido en esta maquina, dos veces seguidas.
#
# Y con respaldo, porque hay un modo de fallo que el lanzador si puede remontar: si
# Terminal.app no esta donde `open` la busca POR NOMBRE -- renombrada, movida, o un macOS
# recortado por una politica de empresa --, se la pide por su IDENTIFICADOR de bundle,
# que es lo que LaunchServices indexa de verdad. Sin ese segundo intento el doble clic no
# hace absolutamente nada, y no queda donde leerlo: el bundle es `LSUIElement` y no tiene
# ni ventana ni terminal donde escribir.
#
# Si los dos fallan se sale con error en vez de darse por bueno. Nadie lee ese codigo en
# un doble clic, pero un lanzador que afirma haber abierto algo que no abrio es la peor
# version del fallo original.
open -a Terminal "$PERFIL" && exit 0
open -b com.apple.Terminal "$PERFIL" && exit 0
exit 1
