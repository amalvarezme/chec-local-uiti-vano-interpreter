  .flow-node {
    min-height: 112px;
    padding: 0.55rem;
    border: 2px solid var(--line);
    border-radius: 8px;
    background: #f8fbfa;
    overflow-wrap: anywhere;
  }

  .flow-node span {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .flow-node strong {
    display: block;
    font-size: 0.82rem;
    line-height: 1.28;
