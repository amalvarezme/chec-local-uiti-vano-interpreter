---
import logoLab from "../assets/site/logos/logo_labIA.png";
import logoChec from "../assets/site/logos/checlogo.png";
import logoUnal from "../assets/site/logos/logo_unal_transparente.png";
import tableroClima from "../assets/site/results/tablero-clima.png";
import tableroAgrupamiento from "../assets/site/results/tablero-agrupamiento.png";
import rankingCircuitos from "../assets/site/results/ranking-circuitos.png";
import tableroTrayCircuitos from "../assets/site/results/tablero-trayectorias-circuitos.png";
import tableroTrayVanos from "../assets/site/results/tablero-trayectorias-vanos.png";
import simuladorMapas from "../assets/site/results/simulador-mapas.png";
import simuladorResultados from "../assets/site/results/simulador-resultados.png";
import variables from "../data/variables.json";






const databricksCommandRows = [
  ["/subir-a-databricks", "Orquestador de todo el flujo B", "Datos -> cuaderno 05 al Workspace -> apps por prioridad -> commit y push de la bitacora"],
  ["/subir-datos-databricks", "data/ completo + site/data/variables.json", "Sube al Volume lo que consumen los cuadernos 01-06 y /report"],
  ["/subir-notebooks-databricks", "Los tres paquetes fuente + los cuadernos de notebooks (copias adaptadas)", "Sube al Workspace; nunca modifica el cuaderno del repositorio"],
  ["/app-vano-clima, /app-agrupamiento-vanos-circuitos, /app-simulador-vano", "Cuadernos 01, 02 y 06", "Databricks Apps con URL fija; son la prioridad cuando el cupo es de 3"],
  ["/app-trayectorias-circuitos, /app-trayectorias-vanos", "Cuadernos 03 y 04", "Se despliegan solo si el workspace admite mas de 3 apps"]
];



const databricksMigrationSteps = [
  ["0", "Preguntar al usuario", "Unico input: la URL del workspace de Databricks destino. Los nombres de las apps usan su valor por defecto."],
  ["1", "Resolver perfil CLI e identidad", "Secciones E1 y E2 del contrato compartido; se resuelve una sola vez."],
  ["2", "Resolver el destino en Unity Catalog", "El catalogo se descubre en tiempo de ejecucion, nunca se asume."],
  ["3", "Verificar los datos en el Volume", "Si estan, no sube nada. Si falta algo, delega en /subir-datos-databricks."],
  ["4", "Importar el cuaderno 05 al Workspace", "Como cuaderno, no como app: es el registro legible del modelo MIL."],
  ["5", "Descubrir el cupo de apps y desplegar", "Por prioridad: 01, 02 y 06 primero; 03 y 04 si el cupo alcanza."],
  ["6", "Commit y push de la bitacora", "En una rama, nunca sobre main."],
  ["7", "Reportar al usuario", "Ruta de la bitacora, estado final y toda restriccion con quien la desbloquea."]
];










const etapas = [
  ["Entradas de información", "Consolidación de fuentes técnicas, históricas y económicas para alimentar el simulador."],
  ["Actualización Prototipo 1", "Ajuste de librerías, base de datos 2025, RAG, normativa y chatbot inteligente."],
  ["Simulación contrafactual", "Escenarios tipo que pasa si para reposición, mantenimiento y eventos extremos."],
  ["Evaluación económica", "Integración de costos de mantenimiento, reposición y retorno de inversión."],
  ["Resultados del simulador", "Visualización tabular y georreferenciada de impactos esperados."],
  ["Soporte a decisiones", "Comparación entre estado actual e intervenciones priorizadas."]
];

const cronograma = [
  ["Ajustes módulo M-GCECDL y agentes", "Actualización de librerías, datos 2025 y flujo local", "Mes 1"],
  ["Ajustes módulo M-GCECDL y agentes", "Actualización de contexto técnico, normativa y documentación", "Mes 1 - Mes 2"],
  ["Simulación contrafactual", "Diseño de arquitectura del simulador", "Mes 1"],
  ["Simulación contrafactual", "Modelado probabilístico con restricciones físicas", "Mes 2 - Mes 3"],
  ["Simulación contrafactual", "Escenarios que pasa si, UiTi por vano y clima extremo", "Mes 2 - Mes 4"],
  ["Evaluación económica dinámica", "Costos, retorno de inversión y ranking de intervenciones", "Mes 2 - Mes 4"],
  ["Visualización y despliegue", "Resultados georreferenciados/tabulares e infraestructura local/nube CHEC", "Mes 1 - Mes 4"],
  ["Validación final", "Pruebas técnicas y ajuste fino", "Mes 4"]
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Resultados de avance del proyecto Simulador de criticidad CHEC - UNAL."
    />
    <title>Simulador Criticidad CHEC | Lab IA UNAL</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Inicio">
        <img src={logoLab.src} alt="Logo Laboratorio IA UNAL" />
      </a>
      <nav aria-label="Navegación principal">
        <a href="#acta">Acta</a>
        <a href="#cronograma">Cronograma</a>
        <a href="#ia-criticidad">IA + Criticidad CHEC</a>
        <a href="#costos-databricks">Costos Databricks</a>
      </nav>
    </header>

    <main id="inicio">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">CHEC + Universidad Nacional de Colombia</p>
          <h1>Simulador de criticidad CHEC</h1>
          <p class="lead">
            Módulos de inteligencia artificial informados por la física, orientados al análisis de criticidad
            e intervenciones en redes de nivel de tensión 2.
          </p>
        </div>
        <aside class="hero-panel" aria-label="Datos principales del proyecto">
          <img class="panel-logo" src={logoLab.src} alt="Laboratorio IA UNAL" />
          <dl>
            <div>
              <dt>Contrato</dt>
              <dd>CRW254513 de 2024</dd>
            </div>
            <div>
              <dt>Acta</dt>
              <dd>Trabajo número 1</dd>
            </div>
            <div>
              <dt>Duración</dt>
              <dd>104 días calendario</dd>
            </div>
            <div>
              <dt>Inicio mes 1</dt>
              <dd>27 de abril de 2026</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="logo-strip" aria-label="Instituciones participantes">
        <img src={logoChec.src} alt="Logo CHEC" />
        <img src={logoUnal.src} alt="Logo Universidad Nacional de Colombia" />
      </section>

      <section id="acta" class="section">
        <div class="section-heading">
          <p class="eyebrow">Resumen del documento</p>
          <h2>Secciones 1 a 9 del acta</h2>
          <p>
            Síntesis ejecutiva del alcance, metodología, resultados esperados, cronograma y entregables del
            proyecto.
          </p>
        </div>

        <div class="summary-grid">
          <article>
            <span>01</span>
            <h3>Abreviaturas</h3>
            <p>CHEC: Central Hidroeléctrica de Caldas S.A. E.S.P. UNAL: Universidad Nacional de Colombia sede Manizales.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Objeto</h3>
            <p>Desarrollar módulos de IA informados por la física y apoyados por agentes para estudiar criticidad y efectividad de intervenciones.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Alcance</h3>
            <p>Simulación contrafactual para reposición y mantenimiento, estimando UiTi por vano y costos con incertidumbre y sensibilidad.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Objetivos</h3>
            <p>Construir módulos de análisis con datos estructurados, modelo multimodal y reportes técnicos de evidencia.</p>
          </article>
          <article>
            <span>05</span>
            <h3>Metodología</h3>
            <p>El trabajo avanza desde entradas de información hasta comparación de escenarios para apoyar decisiones de inversión.</p>
          </article>
          <article>
            <span>06</span>
            <h3>Plazo</h3>
            <p>La ejecución contempla 104 días calendario, con posibilidad de ajustes por acuerdo entre las partes.</p>
          </article>
          <article>
            <span>07</span>
            <h3>Resultado esperado</h3>
            <p>Simulador con visualización georreferenciada y tabular, más actualización de arquitectura local/nube CHEC-EPM.</p>
          </article>
          <article>
            <span>08</span>
            <h3>Cronograma</h3>
            <p>Plan de cuatro meses que integra predicción, simulación, evaluación económica, despliegue y validación final.</p>
          </article>
          <article>
            <span>09</span>
            <h3>Entregables</h3>
            <p>Informe técnico, repositorio GitHub documentado y pruebas piloto del flujo de análisis.</p>
          </article>
        </div>
      </section>

      <section class="section tinted">
        <div class="section-heading compact">
          <p class="eyebrow">Tabla resumida</p>
          <h2>Participantes clave</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Entidad / rol</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Gustavo Agredo Cardona</td>
                <td>Representante legal del contratista - UNAL</td>
              </tr>
              <tr>
                <td>Juan Carlos Álvarez Barreto</td>
                <td>Profesional Subgerencia T&amp;D, gestor técnico</td>
              </tr>
              <tr>
                <td>Luis Alirio Bolaños Navarrete</td>
                <td>Profesional Subgerencia T&amp;D, gestor técnico</td>
              </tr>
              <tr>
                <td>Iván Darío Cardona Jiménez</td>
                <td>Profesional Área Gestión Operativa, gestor administrativo</td>
              </tr>
              <tr>
                <td>Andrés Marino Álvarez Meza</td>
                <td>Director del proyecto por parte de UNAL</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <p class="eyebrow">Ruta metodológica</p>
          <h2>Etapas de trabajo</h2>
        </div>
        <div class="timeline">
          {etapas.map(([title, text], index) => (
            <article>
              <strong>{String(index + 1).padStart(2, "0")}</strong>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="cronograma" class="section tinted">
        <div class="section-heading compact">
          <p class="eyebrow">Tabla resumida</p>
          <h2>Cronograma de avance</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Módulo / etapa</th>
                <th>Actividad principal</th>
                <th>Ventana</th>
              </tr>
            </thead>
            <tbody>
              {cronograma.map(([modulo, actividad, ventana]) => (
                <tr>
                  <td>{modulo}</td>
                  <td>{actividad}</td>
                  <td><span class="pill">{ventana}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section deliverables">
        <div class="section-heading">
          <p class="eyebrow">Sección 9</p>
          <h2>Entregables acordados</h2>
        </div>
        <div class="deliverable-grid">
          <article>
            <h3>Informe técnico</h3>
            <p>Documento con la descripción de los desarrollos, resultados y decisiones técnicas.</p>
          </article>
          <article>
            <h3>Repositorio GitHub</h3>
            <p>Código desarrollado y documentado para facilitar trazabilidad y continuidad.</p>
          </article>
          <article>
            <h3>Pruebas piloto</h3>
            <p>Flujos reproducibles para validar cálculos, procedimientos y actualización de resultados.</p>
          </article>
        </div>
      </section>

      <section id="ia-criticidad" class="section results">
        <div class="section-heading">
          <p class="eyebrow">Lo que hay funcionando hoy</p>
          <h2>IA + Criticidad CHEC</h2>
          <p>
            Cinco aplicaciones locales, un modelo predictivo entrenado, un simulador contrafactual y
            una familia de agentes que redactan los informes. Todo corre en la máquina del usuario
            —en <code>127.0.0.1</code>, sin publicar nada a la red— y todo se puede migrar a
            Databricks con los comandos del final.
          </p>
        </div>

        <nav class="sub-nav" aria-label="Secciones de IA + Criticidad CHEC">
          <a href="#tableros">Tableros</a>
          <a href="#agrupamiento-temporal">Agrupamiento y análisis temporal</a>
          <a href="#modelo-mil">Modelo IA predictiva</a>
          <a href="#simulador">Simulador ¿Qué pasa si…?</a>
          <a href="#agentes-informes">Agentes e informes</a>
          <a href="#migracion-databricks">Migración Databricks</a>
        </nav>
      </section>

      <section id="tableros" class="section tinted">
        <div class="section-heading">
          <p class="eyebrow">IA + Criticidad CHEC · 1 de 6</p>
          <h2>Tableros</h2>
          <p>
            Cuatro visores y un simulador, cada uno con su propio entorno y su puerto fijo, gobernados
            por el menú <strong>CriticidadCHEC</strong>. Los cuatro visores se congelan en HTML estático
            y abren en menos de un segundo; el simulador necesita un intérprete vivo. Los pantallazos de
            abajo son capturas reales de cada tablero servido, con sus gráficas cargadas.
          </p>
        </div>

        <div class="table-wrap compact-table">
          <table>
            <thead><tr><th>Tablero</th><th>Puerto</th><th>Cómo corre</th></tr></thead>
            <tbody>
              <tr><td>CriticidadCHEC (menú)</td><td><code>8800</code></td><td>Servidor de control; abre y apaga a los demás</td></tr>
              <tr><td>Nube por vano y clima</td><td><code>8801</code></td><td>HTML congelado</td></tr>
              <tr><td>Agrupamiento de vanos</td><td><code>8802</code></td><td>HTML congelado</td></tr>
              <tr><td>Trayectorias de circuitos</td><td><code>8803</code></td><td>HTML congelado</td></tr>
              <tr><td>Trayectorias de vanos</td><td><code>8804</code></td><td>HTML congelado</td></tr>
              <tr><td>Simulador ¿Qué pasa si…?</td><td><code>8866</code></td><td>Voila + kernel de Python vivo</td></tr>
            </tbody>
          </table>
        </div>

        <article class="tablero-card" id="tablero-clima">
          <h3>Nube por vano y clima</h3>
          <figure class="shot">
            <img src={tableroClima.src} alt="Tablero de nube por vano y clima, con el mapa del circuito DON23L13 y las gráficas cargadas" loading="lazy" />
            <figcaption>Circuito DON23L13 — 79 días con eventos entre 2025-11-01 y 2026-04-30.</figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>Mapa del circuito con el UITI diario por vano</strong>, con cortes de criticidad fijos e iguales para todos los circuitos (Bajo, Medio, Medio-Alto, Alto), más transformadores e interruptores.</li>
            <li><strong>Nube de la variable climática elegida</strong> superpuesta al mapa: precipitación, temperatura, viento, ráfaga, descargas o vegetación, con su propia escala.</li>
            <li><strong>Dos deslizadores</strong>: el día —solo los que tuvieron eventos— y las horas <em>antes</em> del evento, para mirar la condición previa y no solo la del momento.</li>
            <li><strong>UITI del día contra la mediana de la variable elegida</strong> a lo largo de todo el periodo, en dos ejes.</li>
            <li><strong>Violines de las 12 horas previas</strong>: lluvia y temperatura, viento y ráfaga, vegetación y descargas.</li>
          </ul>

          <h4>Capturar datos nuevos de clima</h4>
          <p>
            El clima no se descarga solo: se pide con el comando <code>/clima</code>, que consulta
            Open-Meteo y tiene <strong>tres compuertas bloqueantes</strong> antes de gastar cuota. La API key
            del modo pago la escribe el usuario, vive solo en memoria y nunca se guarda.
          </p>
          <div class="table-wrap compact-table">
            <table>
              <thead><tr><th>Paso</th><th>Qué decide</th><th>Detalle</th></tr></thead>
              <tbody>
                <tr><td><strong>Modo</strong></td><td>A o B</td><td><strong>A</strong> reescribe <code>data/Indicadores_vano_v3.csv</code> con coordenadas <code>X1</code>/<code>Y1</code>. <strong>B</strong> toma cualquier tabla de <code>data/</code>, con <code>XPOS1_RED_BASE</code>/<code>YPOS1_RED_AFECTA</code>, y deja un CSV nuevo.</td></tr>
                <tr><td><strong>Compuerta 1</strong></td><td>Ubicaciones</td><td>Va primero y es bloqueante: sin coordenadas válidas no se sigue. Se resuelve con <code>a_gate1()</code> o <code>b_gate1(archivo)</code>.</td></tr>
                <tr><td><strong>Compuerta 2</strong></td><td>API gratuita o paga</td><td>La gratuita no pide nada. La paga pide la <code>apikey</code> al usuario, en el momento; no se persiste ni se registra en ningún log.</td></tr>
                <tr><td><strong>Compuerta 3</strong></td><td>Límites de cuota</td><td>Compara las llamadas necesarias contra el presupuesto disponible <em>antes</em> de empezar. Si no alcanza, se detiene y lo dice.</td></tr>
                <tr><td><strong>Salida</strong></td><td>Dónde queda</td><td>Modo A: el mismo v3. Modo B: <code>data/clima_&lt;fuente&gt;_&lt;ini&gt;_a_&lt;fin&gt;.csv</code>. El registro de consumo va aparte, a <code>.clima_cache/</code>.</td></tr>
                <tr><td><strong>Unificar</strong></td><td>Concatenar corridas</td><td>Solo entre archivos con el <strong>mismo</strong> <code>origen_id</code>: mezclar orígenes distintos produce una tabla que parece válida y no lo es.</td></tr>
              </tbody>
            </table>
          </div>
        </article>

        <article class="tablero-card" id="tablero-agrupamiento">
          <h3>Agrupamiento de vanos</h3>
          <figure class="shot">
            <img src={tableroAgrupamiento.src} alt="Tablero de agrupamiento de vanos con los cuatro grupos de criticidad y el ranking de circuitos" loading="lazy" />
            <figcaption>27.390 vanos con eventos entre 2025-11 y 2026-04; K-Means con k=4.</figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>K-Means (k=4) sobre el par (UITI acumulado, número de eventos)</strong> de cada vano. Los grupos se <em>nombran</em> por el ranking de la mediana del UITI —Bajo, Medio, Medio-Alto, Alto—, nunca por el índice que devuelve el algoritmo.</li>
            <li><strong>Rango de fechas ajustable</strong>, redondeado a meses completos, con descarga de las etiquetas resultantes a Excel.</li>
            <li><strong>Reparto por grupo y distribución del UITI</strong>: 4.189 Bajo (15,3 %), 11.449 Medio (41,8 %), 10.314 Medio-Alto (37,7 %) y 1.438 Alto (5,3 %).</li>
            <li><strong>Top 10 de circuitos</strong> por porcentaje de vanos en Medio-Alto + Alto.</li>
            <li><strong>Ranking de los 208 circuitos</strong> por número de vanos Medio-Alto + Alto — el que define el grupo de criticidad del circuito, y el insumo del modelo predictivo.</li>
          </ul>
        </article>

        <article class="tablero-card" id="tablero-trayectorias-circuitos">
          <h3>Trayectorias de circuitos</h3>
          <figure class="shot">
            <img src={tableroTrayCircuitos.src} alt="Tablero de trayectorias de circuitos con ventana deslizante y mapa" loading="lazy" />
            <figcaption>Circuito AGU23L12 — 6 de 11 ventanas con eventos.</figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>Cada punto es un par circuito × ventana</strong>, no un circuito: el mismo circuito aparece tantas veces como ventanas tenga, y así se ve por dónde se mueve en el tiempo.</li>
            <li><strong>Ventana deslizante</strong> sobre las 11 ventanas del periodo, con las fechas exactas a la vista.</li>
            <li><strong>Mapa del circuito con el UITI del vano en la ventana activa</strong>, con los mismos cortes fijos para todos los circuitos.</li>
            <li><strong>Trayectoria del circuito</strong> a lo largo de las ventanas, coloreada por el grupo de cada momento: se ve cuándo salta de grupo y cuándo vuelve.</li>
            <li><strong>Muestras, UITI y eventos por grupo</strong> para leer la trayectoria contra la población entera.</li>
          </ul>
        </article>

        <article class="tablero-card" id="tablero-trayectorias-vanos">
          <h3>Trayectorias de vanos</h3>
          <figure class="shot">
            <img src={tableroTrayVanos.src} alt="Tablero de trayectorias de vanos con la selección por casillas y el perfil del circuito" loading="lazy" />
            <figcaption>Circuito AGU23L12 — 15 de 47 vanos marcados, que concentran el 88,3 % del UITI.</figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>Cada punto es un par vano × ventana</strong>, con el K-Means ajustado <em>una sola vez</em> sobre todas las celdas: los cortes no se recalculan al cambiar de circuito, así que dos circuitos son comparables.</li>
            <li><strong>Selección de vanos por casillas</strong>, con <em>Marcar todos</em> y <em>Desmarcar</em>; lo marcado manda en todos los paneles a la vez.</li>
            <li><strong>Perfil del circuito</strong>: cuánto del UITI del periodo concentran los vanos marcados —en el ejemplo, 15 de 47 vanos explican el 88,3 %—.</li>
            <li><strong>Evolución por vano</strong> con UITI y número de eventos superpuestos, ventana a ventana.</li>
            <li><strong>Es un insumo, no solo un visor</strong>: la geometría que produce este tablero es la que consume después el cálculo de criticidad.</li>
          </ul>
        </article>
      </section>

      <section id="agrupamiento-temporal" class="section">
        <div class="section-heading">
          <p class="eyebrow">IA + Criticidad CHEC · 2 de 6</p>
          <h2>Agrupamiento de vanos y análisis temporal</h2>
          <p>
            De dónde sale la etiqueta de criticidad. No es un umbral escrito a mano: sale de agrupar los
            vanos por su comportamiento observado, y de ordenar después los circuitos por cuántos vanos
            críticos acumulan. Esa etiqueta es lo que el modelo predictivo aprende a anticipar.
          </p>
        </div>

        <figure class="shot wide">
          <img src={rankingCircuitos.src} alt="Ranking de los 208 circuitos por número de vanos en clase Medio-Alto y Alto, con los cortes de las cuatro bandas" loading="lazy" />
          <figcaption>El paso 4 visto en el tablero: los 208 circuitos ordenados por vanos Medio-Alto + Alto, con los cortes de las cuatro bandas.</figcaption>
        </figure>

        <div class="diagram-card">
          <h3>De vano a grupo de circuito, en cuatro pasos</h3>
          <svg viewBox="0 0 960 250" role="img" aria-label="Cadena: vanos, K-Means, nombrado por mediana, ranking de circuitos" class="diagrama">
            <defs>
              <marker id="fl" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto">
                <path d="M0,0 L9,4.5 L0,9 z" fill="#5f6f77" />
              </marker>
            </defs>
            <g font-family="Inter, sans-serif" font-size="13">
