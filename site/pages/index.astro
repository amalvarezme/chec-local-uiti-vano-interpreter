  .flow-lane {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(90px, 0.55fr)
      minmax(108px, 1fr)
      minmax(40px, 0.32fr)
      minmax(108px, 1fr)
      minmax(40px, 0.32fr)
      minmax(108px, 1fr)
      minmax(40px, 0.32fr)
      minmax(108px, 1fr);
