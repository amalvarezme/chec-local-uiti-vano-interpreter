    <script>
      // Ampliar las capturas. Sin JavaScript la pagina queda exactamente como
      // estaba: las figuras siguen visibles en su tamano normal.
      const dialogo = document.getElementById("lightbox");
      const imagen = document.getElementById("lightbox-img");
      const pie = document.getElementById("lightbox-caption");

      if (dialogo && imagen && pie && typeof dialogo.showModal === "function") {
        let disparador = null;

        const abrir = (img) => {
          const figura = img.closest("figure");
          const texto = figura?.querySelector("figcaption")?.textContent?.trim() ?? "";
          imagen.src = img.currentSrc || img.src;
          imagen.alt = img.alt;
          pie.textContent = texto;
          pie.hidden = texto === "";
          disparador = img.closest("button") ?? img;
          dialogo.showModal();
          dialogo.querySelector("[data-lightbox-close]")?.focus();
        };

        document.querySelectorAll(".shot img").forEach((img) => {
          const boton = document.createElement("button");
          boton.type = "button";
          boton.className = "shot-zoom";
          boton.setAttribute("aria-label", `Ampliar la figura: ${img.alt}`);
          img.parentNode.insertBefore(boton, img);
          boton.appendChild(img);
          boton.addEventListener("click", () => abrir(img));
        });

        dialogo.addEventListener("click", (evento) => {
          // Clic en el fondo (fuera del contenido) tambien cierra.
          if (evento.target === dialogo) dialogo.close();
        });
        dialogo.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialogo.close());
        // El dialogo nativo ya cierra con Esc; aqui solo se devuelve el foco.
        dialogo.addEventListener("close", () => {
          imagen.removeAttribute("src");
          disparador?.focus();
        });
      }
    </script>
