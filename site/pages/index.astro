---
import logoLab from "../assets/site/logos/logo_labIA.png";
import logoChec from "../assets/site/logos/checlogo.png";
import logoUnal from "../assets/site/logos/logo_unal_transparente.png";
import tableroClima from "../assets/site/results/tablero-clima.png";
import tableroAgrupamiento from "../assets/site/results/tablero-agrupamiento.png";
import rankingCircuitos from "../assets/site/results/ranking-circuitos.png";
import tableroTrayCircuitos from "../assets/site/results/tablero-trayectorias-circuitos.png";
import tableroTrayVanos from "../assets/site/results/tablero-trayectorias-vanos.png";
import simuladorMapas from "../assets/site/results/simulador-mapas.png";
import simuladorResultados from "../assets/site/results/simulador-resultados.png";
import variables from "../data/variables.json";






const databricksArtefactos = [
  ["1", "data/", "Archivos en el Volume de Unity Catalog", "~945 MB: el CSV de eventos (566), la caché de bolsas (199), los tres shapefiles con sidecars (180), el modelo MIL, el grafo y los .xlsx"],
  ["2", "Dos aplicaciones", "Databricks Apps, cada una en su recurso de cómputo", "Criticidad CHEC sirve los cuatro tableros en cuatro rutas; el Simulador requiere un intérprete de Python en ejecución"],
  ["3", "notebooks/05_mil_vano_ventana.ipynb", "Cuaderno en el Workspace", "El registro legible del modelo MIL; sin outputs, por el tope de 10 MB del importador"]
];



const databricksMigrationSteps = [
  ["Solicitud de la URL del workspace", "Es el único dato que se solicita, y se solicita en cada ejecución: nunca se deduce de un perfil que tenga sesión abierta."],
  ["Resolución del perfil de CLI y de la identidad", "Se derivan de esa URL, una sola vez."],
  ["Resolución del destino en Unity Catalog", "El catálogo se descubre en tiempo de ejecución, nunca se asume."],
  ["Validación de los datos en el Volume", "La etapa verifica primero los archivos existentes y sus tamaños. Solo se transfieren los archivos faltantes, con el fin de evitar transferencias redundantes de gran volumen: retransmitir los 566 MB ya presentes es la operación más costosa del proceso."],
  ["Validación de las aplicaciones en el recurso de cómputo", "Una aplicación se considera operativa cuando se cumplen simultáneamente las condiciones `ACTIVE`, `RUNNING` y último despliegue `SUCCEEDED`. Una aplicación operativa y actualizada no requiere un nuevo despliegue."],
  ["Validación del cuaderno en el workspace", "Se importa sin outputs ni execution_count. Si la etapa anterior de datos quedó bloqueada, el cuaderno queda disponible pero no podrá ejecutarse: esa condición se registra como `degradado`, no como `ok`."],
  ["Registro y publicación de la bitácora", "En una rama, nunca sobre main."],
  ["Generación del reporte de ejecución", "Una fila por etapa, la ruta de la bitácora y cada restricción junto con el responsable de su resolución."]
];










const codigoEnLinea = (texto) =>
  texto
    .split("`")
    .map((parte, i) =>
      i % 2 === 1
        ? `<code>${parte}</code>`
        : parte.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    )
    .join("");

const siteOrigin = (Astro.site ?? new URL("https://amalvarezme.github.io")).origin;
const canonicalUrl = new URL(import.meta.env.BASE_URL, siteOrigin).href;
const ogImageUrl = new URL(simuladorMapas.src, siteOrigin).href;
const faviconUrl = logoLab.src;

const etapas = [
  ["Entradas de información", "Consolidación de fuentes técnicas, históricas y económicas para alimentar el simulador."],
  ["Actualización del prototipo 1", "Actualización de librerías, base de datos de 2025, componentes de generación aumentada por recuperación (RAG), normativa y asistente conversacional."],
  ["Simulación contrafactual", "Escenarios de tipo «¿qué pasa si…?» para reposición, mantenimiento y eventos extremos."],
  ["Evaluación económica", "Integración de costos de mantenimiento, reposición y retorno de inversión."],
  ["Resultados del simulador", "Visualización tabular y georreferenciada de impactos esperados."],
  ["Soporte a decisiones", "Comparación entre estado actual e intervenciones priorizadas."]
];

const cronograma = [
  ["Ajustes módulo M-GCECDL y agentes", "Actualización de librerías, datos 2025 y flujo local", "Mes 1"],
  ["Ajustes módulo M-GCECDL y agentes", "Actualización de contexto técnico, normativa y documentación", "Meses 1\u20132"],
  ["Simulación contrafactual", "Diseño de arquitectura del simulador", "Mes 1"],
  ["Simulación contrafactual", "Modelado probabilístico con restricciones físicas", "Meses 2\u20133"],
  ["Simulación contrafactual", "Escenarios «¿qué pasa si…?», UITI por vano y clima extremo", "Meses 2\u20134"],
  ["Evaluación económica dinámica", "Costos, retorno de inversión y clasificación de intervenciones", "Meses 2\u20134"],
  ["Visualización y despliegue", "Resultados georreferenciados y tabulares e infraestructura en entorno local y nube de CHEC", "Meses 1\u20134"],
  ["Validación final", "Pruebas técnicas y ajuste fino", "Mes 4"]
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Resultados de avance del Simulador de criticidad CHEC: agrupamiento de vanos, modelo MIL predictivo, simulador de escenarios «¿Qué pasa si…?» e informes automáticos, desarrollados por la Universidad Nacional de Colombia, Sede Manizales."
    />
    <title>Simulador de criticidad CHEC | Universidad Nacional de Colombia</title>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />

    <meta property="og:title" content="Simulador de criticidad CHEC | Universidad Nacional de Colombia" />
    <meta
      property="og:description"
      content="Agrupamiento de vanos, modelo MIL predictivo, simulador de escenarios «¿Qué pasa si…?» e informes automáticos para el análisis de criticidad en redes de nivel de tensión 2."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Simulador de criticidad CHEC" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta
      property="og:image:alt"
      content="Simulador de criticidad CHEC: mapas de criticidad original y simulada de un circuito."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Simulador de criticidad CHEC | Universidad Nacional de Colombia" />
    <meta
      name="twitter:description"
      content="Agrupamiento de vanos, modelo MIL predictivo, simulador de escenarios «¿Qué pasa si…?» e informes automáticos para el análisis de criticidad en redes de nivel de tensión 2."
    />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Inicio">
        <img src={logoLab.src} alt="Logo Laboratorio IA UNAL" />
      </a>
      <nav aria-label="Navegación principal">
        <a href="#acta">Acta</a>
        <a href="#cronograma">Cronograma</a>
        <a href="#ia-criticidad">IA + Criticidad CHEC</a>
        <a href="#implementacion">Implementación</a>
        <a href="#instalacion">Instalación</a>
        <a href="#costos-databricks">Costos Databricks</a>
      </nav>
    </header>

    <main id="inicio">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">CHEC y Universidad Nacional de Colombia</p>
          <h1>Simulador de criticidad CHEC</h1>
          <p class="lead">
            Módulos de inteligencia artificial informada por restricciones físicas para el análisis de
            criticidad y la evaluación de intervenciones en redes de nivel de tensión 2.
          </p>
        </div>
        <div class="hero-side">
          <div class="hero-logos" role="img" aria-label="CHEC, Universidad Nacional de Colombia y Laboratorio de Inteligencia Artificial">
            <img src={logoChec.src} alt="" />
            <img src={logoUnal.src} alt="" />
            <img src={logoLab.src} alt="" />
          </div>
          <aside class="hero-panel" aria-label="Datos principales del proyecto">
          <dl>
            <div>
              <dt>Contrato</dt>
              <dd>CRW254513 de 2024</dd>
            </div>
            <div>
              <dt>Acta</dt>
              <dd>Acta de trabajo n.º 1</dd>
            </div>
            <div>
              <dt>Duración</dt>
              <dd>104 días calendario</dd>
            </div>
            <div>
              <dt>Fecha de inicio</dt>
              <dd>27 de abril de 2026</dd>
            </div>
          </dl>
          </aside>
        </div>
      </section>

      <section id="acta" class="section">
        <div class="section-heading">
          <p class="eyebrow">Resumen del documento</p>
          <h2>Secciones 1 a 9 del acta</h2>
          <p>
            Síntesis ejecutiva del alcance, metodología, resultados esperados, cronograma y entregables del
            proyecto.
          </p>
        </div>

        <div class="summary-grid">
          <article>
            <span>01</span>
            <h3>Abreviaturas</h3>
            <p>
              <strong>CHEC:</strong> Central Hidroeléctrica de Caldas S.A. E.S.P.<br />
              <strong>UNAL:</strong> Universidad Nacional de Colombia, Sede Manizales.<br />
              <strong>UITI:</strong> indicador de usuarios interrumpidos por tiempo de interrupción,
              calculado sobre cada falla. <strong>UITI_VANO</strong> es ese indicador ponderado por el
              aporte relativo del vano.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>Objeto</h3>
            <p>Desarrollar módulos de IA informados por la física y apoyados por agentes para estudiar criticidad y efectividad de intervenciones.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Alcance</h3>
            <p>Simulación contrafactual para reposición y mantenimiento, estimando el UITI por vano y los costos con incertidumbre y sensibilidad.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Objetivos</h3>
            <p>Construir módulos de análisis con datos estructurados, modelo multimodal y reportes técnicos de evidencia.</p>
          </article>
          <article>
            <span>05</span>
            <h3>Metodología</h3>
            <p>El trabajo avanza desde entradas de información hasta comparación de escenarios para apoyar decisiones de inversión.</p>
          </article>
          <article>
            <span>06</span>
            <h3>Plazo</h3>
            <p>La ejecución contempla 104 días calendario, con posibilidad de ajustes por acuerdo entre las partes.</p>
          </article>
          <article>
            <span>07</span>
            <h3>Resultado esperado</h3>
            <p>Simulador con visualización georreferenciada y tabular, más actualización de la arquitectura en entorno local y nube de CHEC-EPM.</p>
          </article>
          <article>
            <span>08</span>
            <h3>Cronograma</h3>
            <p>Plan de cuatro meses que integra predicción, simulación, evaluación económica, despliegue y validación final.</p>
          </article>
          <article>
            <span>09</span>
            <h3>Entregables</h3>
            <p>Informe técnico, repositorio GitHub documentado y pruebas piloto del flujo de análisis.</p>
          </article>
        </div>
      </section>

      <section class="section tinted">
        <div class="section-heading compact">
          <p class="eyebrow">Tabla resumida</p>
          <h2>Participantes clave</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Entidad / rol</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Gustavo Agredo Cardona</td>
                <td>Representante legal del contratista (UNAL)</td>
              </tr>
              <tr>
                <td>Juan Carlos Álvarez Barreto</td>
                <td>Profesional Subgerencia T&amp;D, gestor técnico</td>
              </tr>
              <tr>
                <td>Luis Alirio Bolaños Navarrete</td>
                <td>Profesional Subgerencia T&amp;D, gestor técnico</td>
              </tr>
              <tr>
                <td>Iván Darío Cardona Jiménez</td>
                <td>Profesional Área Gestión Operativa, gestor administrativo</td>
              </tr>
              <tr>
                <td>Andrés Marino Álvarez Meza</td>
                <td>Director del proyecto por parte de UNAL</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <p class="eyebrow">Ruta metodológica</p>
          <h2>Etapas de trabajo</h2>
        </div>
        <div class="timeline">
          {etapas.map(([title, text], index) => (
            <article>
              <strong>{String(index + 1).padStart(2, "0")}</strong>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="cronograma" class="section tinted">
        <div class="section-heading compact">
          <p class="eyebrow">Tabla resumida</p>
          <h2>Cronograma de avance</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Módulo / etapa</th>
                <th>Actividad principal</th>
                <th>Ventana</th>
              </tr>
            </thead>
            <tbody>
              {cronograma.map(([modulo, actividad, ventana]) => (
                <tr>
                  <td>{modulo}</td>
                  <td>{actividad}</td>
                  <td><span class="pill">{ventana}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="nota-tabla">
          <strong class="sigla">M-GCECDL</strong> —<em>Multimodal-Graph Connectivity Enhanced and
          Conditioned Deep Learning</em>— es el modelo de inteligencia artificial predictiva para la
          estimación de criticidad, regularizado por restricciones físicas y por un autoencoder del vector
          de características, construido desde el análisis temporal de eventos sobre vanos mediante una
          representación por bolsas y múltiples instancias. Se describe en
          <a href="#modelo-mil">Modelo de IA predictiva M-GCECDL</a>.
        </p>
      </section>

      <section class="section deliverables">
        <div class="section-heading">
          <p class="eyebrow">Sección 9</p>
          <h2>Entregables acordados</h2>
        </div>
        <div class="deliverable-grid">
          <article>
            <h3>Informe técnico</h3>
            <p>Documento con la descripción de los desarrollos, resultados y decisiones técnicas.</p>
          </article>
          <article>
            <h3>Repositorio GitHub</h3>
            <p>Código desarrollado y documentado para facilitar trazabilidad y continuidad.</p>
          </article>
          <article>
            <h3>Pruebas piloto</h3>
            <p>Flujos reproducibles para validar cálculos, procedimientos y actualización de resultados.</p>
          </article>
        </div>
      </section>

      <section id="ia-criticidad" class="section results">
        <div class="section-heading">
          <p class="eyebrow">Componentes en operación</p>
          <h2>IA + Criticidad CHEC</h2>
          <p>
            La solución integra cinco aplicaciones locales, un modelo predictivo entrenado, un simulador
            contrafactual y un conjunto de agentes para la generación de informes. Todos los componentes
            se ejecutan localmente en <code>127.0.0.1</code>, sin exponer servicios a la red, y pueden
            desplegarse en Databricks mediante el procedimiento descrito en la sección de migración.
          </p>
        </div>

        <nav class="sub-nav" aria-label="Secciones de IA + Criticidad CHEC">
          <a href="#tableros">Tableros</a>
          <a href="#agrupamiento-temporal">Agrupamiento y análisis temporal</a>
          <a href="#modelo-mil">Modelo IA predictiva</a>
          <a href="#simulador">Simulador «¿Qué pasa si…?»</a>
          <a href="#agentes-informes">Agentes e informes</a>
          <a href="#migracion-databricks">Migración Databricks</a>
        </nav>
      </section>

      <section id="tableros" class="section tinted">
        <div class="section-heading">
          <p class="eyebrow">IA + Criticidad CHEC · 1 de 6</p>
          <h2>Tableros</h2>
          <p>
            El sistema dispone de cuatro visores y un simulador, cada uno con su propio entorno y su
            puerto fijo, gobernados por el menú <strong>CriticidadCHEC</strong>. Los cuatro visores se
            publican como HTML estático y se cargan en menos de un segundo; el simulador requiere un
            intérprete de Python en ejecución. Las imágenes siguientes corresponden a capturas de
            pantalla de cada tablero servido, con sus gráficas cargadas.
          </p>
        </div>

        <div class="table-wrap compact-table">
          <table>
            <thead><tr><th>Tablero</th><th>Puerto</th><th>Modo de ejecución</th></tr></thead>
            <tbody>
              <tr><td>CriticidadCHEC (menú)</td><td><code>8800</code></td><td>Servidor de control; inicia y detiene los demás servicios</td></tr>
              <tr><td>Nube por vano y clima</td><td><code>8801</code></td><td>HTML estático</td></tr>
              <tr><td>Agrupamiento de vanos</td><td><code>8802</code></td><td>HTML estático</td></tr>
              <tr><td>Trayectorias de circuitos</td><td><code>8803</code></td><td>HTML estático</td></tr>
              <tr><td>Trayectorias de vanos</td><td><code>8804</code></td><td>HTML estático</td></tr>
              <tr><td>Simulador «¿Qué pasa si…?»</td><td><code>8866</code></td><td>Voilà + kernel de Python en ejecución</td></tr>
            </tbody>
          </table>
        </div>

        <article class="tablero-card" id="tablero-clima">
          <h3>Nube por vano y clima</h3>
          <figure class="shot">
            <img src={tableroClima.src} alt="Tablero de nube por vano y clima, con el mapa del circuito DON23L13 y las gráficas cargadas" loading="lazy" />
            <figcaption><strong>Figura 1. Nube por vano y clima del circuito DON23L13.</strong> Captura del tablero interactivo, con 79 días con eventos entre el 1 de noviembre de 2025 y el 30 de abril de 2026.</figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>Mapa del circuito con el UITI diario por vano</strong>, con cortes de criticidad fijos e iguales para todos los circuitos (Bajo, Medio, Medio-Alto, Alto), más transformadores e interruptores.</li>
            <li><strong>Nube de la variable climática elegida</strong> superpuesta al mapa: precipitación, temperatura, viento, ráfaga, descargas o vegetación, con su propia escala.</li>
            <li><strong>Dos deslizadores</strong>: el día —solo los que tuvieron eventos— y las horas <em>antes</em> del evento, para mirar la condición previa y no solo la del momento.</li>
            <li><strong>UITI del día contra la mediana de la variable elegida</strong> a lo largo de todo el periodo, en dos ejes.</li>
            <li><strong>Violines de las 12 horas previas</strong>: lluvia y temperatura, viento y ráfaga, vegetación y descargas.</li>
          </ul>

          <h4>Capturar datos nuevos de clima</h4>
          <p>
            Los datos climáticos se obtienen mediante el comando <code>/clima</code>, que consulta
            Open-Meteo y ejecuta <strong>tres validaciones obligatorias</strong> antes de consumir cuota de
            la API. La clave de API de la modalidad de pago la introduce el usuario, permanece solo en
            memoria y no se almacena.
          </p>
          <div class="table-wrap compact-table">
            <table>
              <thead><tr><th>Paso</th><th>Aspecto que resuelve</th><th>Detalle</th></tr></thead>
              <tbody>
                <tr><td><strong>Modo</strong></td><td>A o B</td><td><strong>A</strong> reescribe <code>data/Indicadores_vano_v3.csv</code> con coordenadas <code>X1</code>/<code>Y1</code>. <strong>B</strong> toma cualquier tabla de <code>data/</code>, con <code>XPOS1_RED_BASE</code>/<code>YPOS1_RED_AFECTA</code>, y deja un CSV nuevo.</td></tr>
                <tr><td><strong>Validación 1</strong></td><td>Ubicaciones</td><td>Se ejecuta en primer lugar y es obligatoria: el proceso no continúa si no se dispone de coordenadas válidas. Se resuelve con <code>a_gate1()</code> o <code>b_gate1(archivo)</code>.</td></tr>
                <tr><td><strong>Validación 2</strong></td><td>API gratuita o de pago</td><td>La modalidad gratuita no requiere credenciales. La modalidad de pago solicita la clave de API (<code>apikey</code>) al usuario en el momento; no se persiste ni se registra en ningún log.</td></tr>
                <tr><td><strong>Validación 3</strong></td><td>Límites de cuota</td><td>Compara las llamadas necesarias contra el presupuesto disponible <em>antes</em> de iniciar la descarga. Si la cuota disponible es insuficiente, el proceso se detiene e informa la condición.</td></tr>
                <tr><td><strong>Salida</strong></td><td>Ubicación de salida</td><td>Modo A: el mismo v3. Modo B: <code>data/clima_&lt;fuente&gt;_&lt;ini&gt;_a_&lt;fin&gt;.csv</code>. El registro de consumo va aparte, a <code>.clima_cache/</code>.</td></tr>
                <tr><td><strong>Unificar</strong></td><td>Concatenar ejecuciones</td><td>Solo entre archivos con el <strong>mismo</strong> <code>origen_id</code>: la combinación de orígenes diferentes puede producir una tabla estructuralmente válida, pero semánticamente inconsistente.</td></tr>
              </tbody>
            </table>
          </div>
        </article>

        <article class="tablero-card" id="tablero-agrupamiento">
          <h3>Agrupamiento de vanos</h3>
          <figure class="shot">
            <img src={tableroAgrupamiento.src} alt="Tablero de agrupamiento de vanos con los cuatro grupos de criticidad y el ranking de circuitos" loading="lazy" />
            <figcaption><strong>Figura 2. Agrupamiento de vanos por criticidad.</strong> 27.390 vanos con eventos entre noviembre de 2025 y abril de 2026, agrupados mediante <code>k-means</code> con k = 4.</figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>k-means (k = 4) sobre el par (UITI acumulado, número de eventos)</strong> de cada vano. Los grupos se <em>nombran</em> según el orden de la mediana del UITI —Bajo, Medio, Medio-Alto, Alto—, nunca según el índice que devuelve el algoritmo.</li>
            <li><strong>Rango de fechas ajustable</strong>, redondeado a meses completos, con descarga de las etiquetas resultantes a Excel.</li>
            <li><strong>Reparto por grupo y distribución del UITI</strong>: 4.189 Bajo (15,3 %), 11.449 Medio (41,8 %), 10.314 Medio-Alto (37,7 %) y 1.438 Alto (5,3 %).</li>
            <li><strong>10 circuitos con mayor porcentaje de vanos</strong> en Medio-Alto + Alto.</li>
            <li><strong>Clasificación de los 208 circuitos</strong> por número de vanos Medio-Alto + Alto, que define el grupo de criticidad del circuito y constituye el insumo del modelo predictivo.</li>
          </ul>
        </article>

        <article class="tablero-card" id="tablero-trayectorias-circuitos">
          <h3>Trayectorias de circuitos</h3>
          <figure class="shot">
            <img src={tableroTrayCircuitos.src} alt="Tablero de trayectorias de circuitos con ventana deslizante y mapa" loading="lazy" />
            <figcaption><strong>Figura 3. Trayectorias de circuitos.</strong> Captura del tablero interactivo para el circuito AGU23L12, con 6 de 11 ventanas con eventos.</figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>Cada punto es un par circuito × ventana</strong>, no un circuito: el mismo circuito aparece tantas veces como ventanas tenga, lo que permite observar su desplazamiento a lo largo del tiempo.</li>
            <li><strong>Ventana deslizante</strong> sobre las 11 ventanas del periodo, con las fechas exactas a la vista.</li>
            <li><strong>Mapa del circuito con el UITI del vano en la ventana activa</strong>, con los mismos cortes fijos para todos los circuitos.</li>
            <li><strong>Trayectoria del circuito</strong> a lo largo de las ventanas, coloreada por el grupo de cada momento: se ve cuándo salta de grupo y cuándo vuelve.</li>
            <li><strong>Muestras, UITI y eventos por grupo</strong> para leer la trayectoria contra la población entera.</li>
          </ul>
        </article>

        <article class="tablero-card" id="tablero-trayectorias-vanos">
          <h3>Trayectorias de vanos</h3>
          <figure class="shot">
            <img src={tableroTrayVanos.src} alt="Tablero de trayectorias de vanos con la selección por casillas y el perfil del circuito" loading="lazy" />
            <figcaption>
              <strong>Figura 4. Trayectorias de vanos del circuito AGU23L12.</strong> Captura del tablero
              interactivo, con 15 de 47 vanos seleccionados que concentran el 88,3 % del UITI. Se presentan
              el panel de selección, el perfil del circuito y la evolución por vano.
            </figcaption>
          </figure>
          <ul class="func-list">
            <li><strong>Cada punto es un par vano × ventana</strong>, con el k-means ajustado <em>una sola vez</em> sobre todas las celdas: los cortes no se recalculan al cambiar de circuito, así que dos circuitos son comparables.</li>
            <li><strong>Selección de vanos por casillas</strong>, con <em>Marcar todos</em> y <em>Desmarcar</em>; la selección se aplica de forma simultánea a todos los paneles.</li>
            <li><strong>Perfil del circuito</strong>: cuánto del UITI del periodo concentran los vanos marcados —en el ejemplo, 15 de 47 vanos explican el 88,3 %—.</li>
            <li><strong>Evolución por vano</strong> con UITI y número de eventos superpuestos, ventana a ventana.</li>
            <li><strong>Es un insumo, no solo un visor</strong>: la geometría que produce este tablero es la que consume después el cálculo de criticidad.</li>
          </ul>
        </article>
      </section>

      <section id="agrupamiento-temporal" class="section">
        <div class="section-heading">
          <p class="eyebrow">IA + Criticidad CHEC · 2 de 6</p>
          <h2>Agrupamiento de vanos y análisis temporal</h2>
          <p>
            Origen de la etiqueta de criticidad. La etiqueta no corresponde a un umbral definido
            manualmente; se obtiene mediante el agrupamiento de los vanos según su comportamiento observado
            y la posterior ordenación de los circuitos por el número de vanos críticos acumulados. Esa
            etiqueta es la que el modelo predictivo aprende a anticipar.
          </p>
        </div>

        <figure class="shot wide">
          <img src={rankingCircuitos.src} alt="Ranking de los 208 circuitos por número de vanos en clase Medio-Alto y Alto, con los cortes de las cuatro bandas de riesgo" loading="lazy" />
