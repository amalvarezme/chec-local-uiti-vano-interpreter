      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Cerrar la vista ampliada">
        Cerrar ✕
      </button>
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption"></p>
    </dialog>

