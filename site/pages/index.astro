  .flow-connector {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 112px;
    color: var(--green);
    text-align: center;
  }

  .flow-connector::before,
  .flow-connector::after {
    content: "";
    position: absolute;
    top: 50%;
    z-index: 0;
    display: block;
  }

  .flow-connector::before {
    left: 4px;
    right: 14px;
    height: 2px;
    background: currentColor;
  }

  .flow-connector::after {
    right: 4px;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-block: 6px solid transparent;
    border-left: 9px solid currentColor;
    background: transparent;
  }

  .flow-connector strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    min-height: 26px;
    margin: 0.3rem 0;
    z-index: 1;
    color: white;
    background: var(--green);
    border-radius: 999px;
    font-size: 0.68rem;
  }

  .flow-connector span {
    max-width: 100%;
    z-index: 1;
    padding: 0.12rem 0.2rem;
    color: var(--muted);
    background: #f8fbfa;
    font-size: 0.64rem;
    font-weight: 800;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .flow-connector.dashed::before {
    background: repeating-linear-gradient(90deg, currentColor 0 7px, transparent 7px 12px);
  }

  .flow-connector.bidirectional::after {
    content: "↔";
    top: 50%;
    right: 50%;
    width: auto;
    height: auto;
    border: 0;
    background: #f8fbfa;
    font-size: 1.2rem;
    font-weight: 900;
    transform: translate(50%, -50%);
  }

  .flow-connector.merge strong {
    background: var(--blue);
  }

  .flow-connector.cycle strong {
    background: #7c5a0d;
  }

