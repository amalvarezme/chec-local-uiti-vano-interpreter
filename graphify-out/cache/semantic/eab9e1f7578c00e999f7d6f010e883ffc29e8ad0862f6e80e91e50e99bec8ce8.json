{"nodes": [{"id": "aplicaciones_rendimiento_y_requisitos_rendimiento_de_aplicaciones", "label": "Rendimiento y requisitos de las aplicaciones (medido)", "file_type": "document", "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aplicaciones_rendimiento_y_requisitos_paquete_precalculado", "label": "El paquete precalculado del simulador", "file_type": "rationale", "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El cuaderno tal cual lee 909 MB al arrancar y deja 2.867 MB residentes; con el paquete son 94,5 MB leidos y 579 MB residentes. Como Voila da un kernel por sesion, eso fija el techo: sin paquete una app MEDIUM aguanta UNA sesion, con paquete seis o siete. En local ademas no se precalienta kernel: medido, no mejoraba la espera (4,78 s contra 4,45 s) y dejaba 1.694 MB contra 931 MB."}, {"id": "aplicaciones_rendimiento_y_requisitos_diferencias_de_windows", "label": "Las tres diferencias reales de Windows (SIGKILL, SO_REUSEADDR, CRLF)", "file_type": "rationale", "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "signal.SIGKILL no existe alli; SO_REUSEADDR significa lo OPUESTO (permite que dos procesos se aten al mismo puerto), por eso allow_reuse_address = not ES_WINDOWS; y los .bat con finales Unix fallan de formas que no parecen error de sintaxis. Ninguno se ve leyendo el codigo en un Mac. Un cuarto punto de criterio: el texto a la terminal va sin tildes porque la consola de Windows no siempre esta en UTF-8, el del navegador si las lleva."}, {"id": "aplicaciones_rendimiento_y_requisitos_restricciones_de_databricks", "label": "Restricciones del entorno Databricks (serverless, catalogo, grants, cupo)", "file_type": "concept", "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "aplicaciones_rendimiento_y_requisitos_rendimiento_de_aplicaciones", "target": "docs_requisitos_minimos_requisitos_minimos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "weight": 1.0}, {"source": "aplicaciones_rendimiento_y_requisitos_diferencias_de_windows", "target": "aplicaciones_probar_en_windows_nivel_1_github_actions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "weight": 1.0}, {"source": "aplicaciones_rendimiento_y_requisitos_rendimiento_de_aplicaciones", "target": "aplicaciones_probar_en_windows_nivel_1_github_actions", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "weight": 1.0}, {"source": "aplicaciones_rendimiento_y_requisitos_paquete_precalculado", "target": "aplicaciones_databricks_readme_app_simulador", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "weight": 1.0}, {"source": "aplicaciones_rendimiento_y_requisitos_restricciones_de_databricks", "target": "docs_flujo_detallado_restricciones_d1_d10", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "aplicaciones/RENDIMIENTO-Y-REQUISITOS.md", "source_location": null, "weight": 1.0}], "hyperedges": []}