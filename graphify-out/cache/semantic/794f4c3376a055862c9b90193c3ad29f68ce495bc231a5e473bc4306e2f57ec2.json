{"nodes": [{"id": "requirements_graphify_optional_cli", "label": "graphify CLI Is an Optional External Binary", "file_type": "rationale", "rationale": "graph_extractor.build_graphify_context shells out to an external `graphify` binary (a Claude Code skill's bundled tool, not a PyPI package) via subprocess.run. It is optional at runtime because the function degrades gracefully to a native PyVis fallback graph when the binary is absent or fails \u2014 so it is deliberately not pip-installed.", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_fastapi_httpx_for_tests", "label": "fastapi + httpx Exist Only to Test the Databricks App", "file_type": "rationale", "rationale": "The consolidated criticidad_chec app's app.py runs in the Databricks container, not this environment, but routing, gzip negotiation and cache headers ARE tested here. Without fastapi and httpx that test would be skipped, and a silently skipped test reads exactly like a passing one. databricks-sdk is not needed: the test substitutes a disk-reading double for the one call this environment cannot really make.", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_anywidget_figurewidget", "label": "anywidget Backs plotly>=6 FigureWidget", "file_type": "rationale", "rationale": "ipywidgets drives 01.5's live-kernel controls, and plotly>=6's go.FigureWidget raises ImportError without anywidget \u2014 so anywidget is a hard, non-obvious dependency of the interactive dashboards.", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_umap_no_consumer", "label": "umap-learn Has No In-Repo Consumer", "file_type": "rationale", "rationale": "umap-learn was the 2D projection of MGCECDL embeddings; it has had no in-repo consumer since notebooks 11/12 were removed, and is documented as such rather than silently kept.", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_papermill_kaggle_harness", "label": "papermill Powers the Kaggle smoke/full Harness", "file_type": "rationale", "rationale": "Parametrized notebook execution via papermill is what lets /experimento-kaggle run the same notebook in smoke and full modes.", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_kaggle_cli", "label": "kaggle CLI dependency", "file_type": "concept", "rationale": "Used by /experimento-kaggle's auth/config plus push/status/output commands; the skill never stores the user's credentials itself.", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_weather_api_stack", "label": "Open-Meteo Client Stack (openmeteo-requests, requests-cache, retry-requests)", "file_type": "concept", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_pdf_extraction_stack", "label": "PDF Extraction Stack (PyMuPDF, pdfplumber)", "file_type": "concept", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "requirements_torch_shap_stack", "label": "Deep Learning / Inference Stack (torch, shap)", "file_type": "concept", "source_file": "requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "requirements_kaggle_cli", "target": "_pi_skills_experimento_kaggle_skill_experimento_kaggle", "relation": "