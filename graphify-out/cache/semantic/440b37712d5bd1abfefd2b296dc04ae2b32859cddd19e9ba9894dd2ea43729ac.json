{"nodes": [{"id": "_pi_skills_report_skill_report", "label": "Pi Report Skill Adapter", "file_type": "document", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_environment_bootstrap", "label": "Mandatory PYTHONPATH=src Virtualenv Bootstrap", "file_type": "rationale", "rationale": "Every report-contract and role CLI command runs from the repository root as `PYTHONPATH=src .venv/bin/python`. Bare python/python3 must not be tried first, and the environment must not be declared unavailable merely because they cannot import chec_local_interpreter \u2014 the virtualenv-prefixed form is the repository's only supported local command.", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_role_delegation_guard", "label": "Role-Authoring Delegation Guard", "file_type": "rationale", "rationale": "A role author must be able to run agent_tools.<role> build-context/validate and write run_dir/<role>.out.json. Delegating role authoring to a read-only generic worker leaves the run stalled. One explicit task per role, naming the role and its run_dir/<role>.bc.json on the first line; never launch identical workers with a shared prompt that forces the worker to infer whether it is historical, inference or expert-alignment. Before prepare_expert_alignment or render, historical.out.json and inference.out.json must exist and validate, otherwise stop and report the stalled role instead of claiming the report is generating.", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_record_usage", "label": "Structured Subagent Usage Recording", "file_type": "rationale", "rationale": "Take the structured `usage` from each subagent_run result and call report_contract record-usage per stage, then verify-usage before render. Never scrape prose or session history and never substitute chars//4 estimates. Pi reports one combined total per role, so the input/output split is unavailable and must not be treated as the full-run count; a stage with no measured total is omitted rather than invented.", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_record_duration", "label": "Orchestrator-Owned Wall-Clock Duration", "file_type": "rationale", "rationale": "Pi's subagent_run result exposes a combined usage total and NO duration field, so the orchestrator's own wall-clock delta around each dispatch is the ONLY duration source and is always available. Record the final successful attempt's delta only via record-duration; per-stage duration therefore renders as `medidos` on Pi even though per-stage tokens stay a combined total.", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_model_resolution", "label": "Runtime-Evidence Model Resolution", "file_type": "rationale", "rationale": "The shared contract resolves the effective Pi model from explicit flags/env, then Pi session history, then ~/.pi/agent/settings.json. Markdown frontmatter must never be read as model authority, because it can claim a model the run did not actually use.", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_lone_date_rejection", "label": "Lone-Date Argument Rejection", "file_type": "rationale", "rationale": "circuito is required and dates are optional only as a pair; a single date is rejected immediately and the missing bound is never inferred, so an ambiguous window can never silently become the studied period.", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_report_contract_module", "label": "report_contract.py (normalized request/outcome serialization)", "file_type": "concept", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_report_skill_report_pipeline_module", "label": "report_pipeline.py (report-domain behavior)", "file_type": "concept", "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_environment_bootstrap", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_role_delegation_guard", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_record_usage", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_record_duration", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_model_resolution", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_lone_date_rejection", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_report_pipeline_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_report", "target": "_pi_skills_report_skill_report_contract_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_record_usage", "target": "_pi_skills_report_skill_report_contract_module", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_record_duration", "target": "_pi_skills_report_skill_report_contract_module", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_role_delegation_guard", "target": "_pi_agents_historical_role", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_pi_skills_report_skill_role_delegation_guard", "target": "_pi_agents_inference_role", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".pi/skills/report/S