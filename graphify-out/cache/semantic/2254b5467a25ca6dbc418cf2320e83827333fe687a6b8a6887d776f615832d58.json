{"nodes": [{"id": "_pi_skills_experimento_kaggle_skill_experimento_kaggle", "label": "Pi Kaggle Experiment Skill", "file_type": "document", "source_file": ".pi/skills/experimento-kaggle/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_experimento_kaggle_skill_human_approval_gate", "label": "Mandatory Human-Approval Gate Before Kaggle Push", "file_type": "rationale", "rationale": "Never push to Kaggle without explicit user approval of the block diagram and notebook, and never run unattended. Uploading any local file as a private Kaggle dataset requires a SECOND, separate explicit approval distinct from the notebook gate \u2014 because data egress and code execution are different risks that a single consent cannot cover.", "source_file": ".pi/skills/experimento-kaggle/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_experimento_kaggle_skill_no_reimplementation_rule", "label": "No-Reimplementation Rule for Existing src/ Models", "file_type": "rationale", "rationale": "Never reimplement a model that already exists in src/. The rule, its precondition guard and the Experiment Families dispatch table live only in the canonical Claude skill; the Pi adapter must not copy their text or baseline digits, so the two runtimes cannot drift on what counts as a baseline.", "source_file": ".pi/skills/experimento-kaggle/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_pi_skills_experimento_kaggle_skill_smoke_before_full", "label": "Smoke-Before-Full Verification Rule", "file_type": "rationale", "rationale": "A smoke notebook must verify the experiment before the full run is pushed, so a broken notebook fails cheaply instead of consuming a full accelerator session.", "source_file": ".pi/skills/experimento-kaggle/SKILL.md", "source_location": nul