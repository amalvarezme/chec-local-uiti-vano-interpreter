ale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No se agrega Databricks, Dash, FastAPI, RAG ni bases vectoriales a src/chec_local_interpreter ni a los roles LLM. La familia /subir-*-databricks y /app-* es un arbol de comandos aislado, manual y bajo demanda, que nunca toca report_pipeline.py ni las dependencias de runtime del pipeline local."}, {"id": "agents_columnas_opcionales_faltantes", "label": "Columnas opcionales faltantes (unavailable_optional_columns)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_salida_llm_invalida", "label": "Salida LLM invalida se archiva, nunca se presenta como analisis final", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_expectativas_de_pruebas", "label": "pytest -q + evals/run_llm_eval.py antes de dar por completo un cambio", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_clima", "label": "/clima (runbook de enriquecimiento climatico, clima_engine.py)", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_redaccion_es", "label": "/redaccion-es (skill canonico de revision de redaccion)", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_chec_local_uiti_vano_interpreter", "target": "agents_cero_api_llm_externa", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md",