# paneles autocontenidos que exportan los cuadernos (decenas de MB por corrida)
reports/paneles/*
!reports/paneles/.gitkeep
# bitacoras de despliegue: el .md se conserva (es el reporte de restricciones que
# se le lleva al dueno del catalogo), el .json es solo el estado del renderizador
reports/despliegues/*
!reports/despliegues/.gitkeep
!reports/despliegues/*.md
lib/

.vscode/
.DS_Store
**/.DS_Store

# graphify knowledge graph outputs
graphify-out/
outputs/graphify_workspace/

# Claude Code local config and memory (agent, skill, and command definitions are tracked)
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/**

# Web (Astro) — root project
node_modules/
dist/
.astro/
.npm-cache/

# Gentle AI local harness metadata
.atl/
.pi/gentle-ai/
openspec/

# Climate skill runtime cache
.clima_cache/

# LaTeX impact report — local-only sources and build artifacts (~141 MB of figures).
# Se excluye el contenido, no el directorio: git no puede re-incluir un archivo si su
# directorio padre esta excluido. Solo el informe tecnico entregable queda versionado.
Informe_Impacto_CHEC/*
!Informe_Impacto_CHEC/informe_tecnico.tex
!Informe_Impacto_CHEC/informe_tecnico.pdf

# Never track compiled Python caches, even under the re-included .claude/skills/**
.claude/skills/**/__pycache__/
**/__pycache__/
*.pyc

# Aplicaciones locales (notebooks/project_flow/aplicaciones/): todo lo que producen
# es artefacto de cada maquina y se regenera con instalar + iniciar. Los entornos
# pesan 484 MB, 530 MB y 1,6 GB; el tablero de clima construido, 27,8 MB; el paquete
# del simulador, 95,2 MB.
notebooks/project_flow/aplicaciones/*/.venv/
notebooks/project_flow/aplicaciones/*/panel/
notebooks/project_flow/aplicaciones/*/paquete/
notebooks/project_flow/aplicaciones/*/cuaderno/
# El pid del servidor de Voila, que la app escribe al arrancar y borra al salir.
notebooks/project_flow/aplicaciones/*/.servidor.pid
