.env
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
.ipynb_checkpoints/

data/*
!data/.gitkeep
!data/Variables_seleccion.xlsx
!data/Variables_simular.xlsx
!data/Actividades_mantenimiento_costos_2026.xlsx
!data/Indicadores_vano_v3.csv
!data/COSTOS ITEMS CONTRATOS.xlsx
!data/geometria_kmeans_014_v1.json
# El cache de bolsas SI se versiona, por LFS. Es lo unico de data/derived/ que
# viaja: el simulador no se puede construir sin el y la subida a Databricks se
# hace clonando este repo en otra maquina. Los demas derivados son caches que
# se rehacen solos (catalogo de controles, relevancias) o salidas opcionales
# del cuaderno 05 (el .npz de predicciones fuera de pliegue).
!data/derived/
data/derived/*
!data/derived/bolsas_mil_full.joblib
!data/GEO/
!data/GEO/**
!data/models
!data/models/**
!data/graphs/
!data/graphs/**
!data/optuna/
!data/optuna/**

# Corridas de /report y /reporte-lote. El HTML no se versiona: son cientos de MB
# regenerables, y `reports/vault/*.md` ya conserva lo que hay que conservar de cada
# corrida -- la narrativa validada.
reports/reportescircuitos/runs/
reports/reportescircuitos/artifacts/*
!reports/reportescircuitos/artifacts/.gitkeep
reports/reportescircuitos/published/**
!reports/reportescircuitos/published/.gitkeep
reports/reportescircuitos/html/*
!reports/reportescircuitos/html/.gitkeep
# Informes gerenciales: mismo criterio, y ademas sintetizan corridas que ya estan.
reports/informesgerenciales/*
!reports/informesgerenciales/.gitkeep
reports/graphify/*
!reports/graphify/.gitkeep
reports/vault/*
!reports/vault/.gitkeep
!reports/vault/*.md
# Paneles autocontenidos que exportan los cuadernos 01-04 (decenas de MB por corrida).
# No es una carpeta de corridas de /report: es la salida de esos cuadernos y la entrada
# del constructor de las aplicaciones locales, que la vuelve a crear en cada build.
reports/paneles/*
!reports/paneles/.gitkeep
# bitacoras de despliegue: el .md se conserva (es el reporte de restricciones que
# se le lleva al dueno del catalogo), el .json es solo el estado del renderizador
reports/despliegues/*
!reports/despliegues/.gitkeep
!reports/despliegues/*.md
lib/

.vscode/
.DS_Store
**/.DS_Store

# graphify knowledge graph outputs
graphify-out/
outputs/graphify_workspace/

# Claude Code local config and memory (agent, skill, and command definitions are tracked)
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/**

# Web (Astro) — root project
node_modules/
dist/
.astro/
.npm-cache/

# Gentle AI local harness metadata
.atl/
openspec/

# Climate skill runtime cache
.clima_cache/

# LaTeX impact report — local-only sources and build artifacts (~141 MB of figures).
# Se excluye el contenido, no el directorio: git no puede re-incluir un archivo si su
# directorio padre esta excluido. Solo el informe tecnico entregable queda versionado.
Informe_Impacto_CHEC/*
!Informe_Impacto_CHEC/informe_tecnico.tex
!Informe_Impacto_CHEC/informe_tecnico.pdf

# Never track compiled Python caches, even under the re-included .claude/skills/**
.claude/skills/**/__pycache__/
**/__pycache__/
*.pyc

# Aplicaciones locales (aplicaciones/): todo lo que producen
# es artefacto de cada maquina y se regenera con instalar + iniciar. Los cinco entornos
# pesan 484 MB, 530 MB, 633 MB, 633 MB y 1,6 GB; los tableros construidos van de 10,5 MB
# a 27,8 MB; el paquete del simulador, 95,2 MB. En total mas de 4 GB que no son fuente.
aplicaciones/*/.venv/
# Sin barra final ademas de con ella: en un `git worktree` el entorno no se duplica,
# se ENLAZA al del arbol principal, y un patron con barra solo casa directorios. Git
# ve un enlace, asi que sin esta linea el entorno aparece sin seguir en cada
# `git status` de un worktree y acaba colandose en un `git add -A`.
aplicaciones/*/.venv
aplicaciones/*/panel/
aplicaciones/*/paquete/
aplicaciones/*/cuaderno/
# El pid del servidor de Voila, que la app escribe al arrancar y borra al salir.
aplicaciones/*/.servidor.pid
